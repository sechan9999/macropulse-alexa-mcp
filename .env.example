# Used by mcp_server.py (the Streamlit app instead reads .streamlit/secrets.toml,
# falling back to these same env vars).

# Required for get_macro_briefing — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional — improves credit-spread / yield-curve accuracy (falls back to a
# deterministic proxy otherwise). Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional — port for the MCP server's Streamable HTTP endpoint (default 8000)
PORT=8000

# Optional — enables get_macro_briefing(provider="bedrock") (AWS Builder mini
# challenge integration). Uses the standard AWS credential chain: these two
# env vars, or `aws configure`, or an IAM role if running on AWS compute.
# Get keys from IAM: https://console.aws.amazon.com/iam/home#/security_credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# Optional — Bedrock model to use for provider="bedrock". Defaults to Amazon
# Nova Pro, which is generally available without a per-model access request.
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
